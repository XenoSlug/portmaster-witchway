#!/bin/bash
# ==============================================================================
# WitchWay Asset Preparation Script
# ==============================================================================

GAMEDIR="$(cd "$(dirname "$0")/.." && pwd)"
LOGFILE="$GAMEDIR/patchlog.txt"

exec > >(tee -a "$LOGFILE") 2>&1
echo "=== Starting WitchWay asset preparation ==="
echo "Working directory: $GAMEDIR"

# Ensure tools are executable
chmod +x "$GAMEDIR/tools/7zzs" 2>/dev/null || true
chmod +x "$GAMEDIR/tools/patch_witchway.py" 2>/dev/null || true

# Run python patch script
python3 "$GAMEDIR/tools/patch_witchway.py"
RET=$?

if [ $RET -eq 0 ] && [ -f "$GAMEDIR/game.port" ]; then
    echo "WitchWay patching succeeded! game.port size: $(wc -c < "$GAMEDIR/game.port") bytes"
    touch "$GAMEDIR/install_completed"
    exit 0
else
    echo "ERROR: WitchWay patching failed with code $RET!"
    exit 1
fi
